# зависимости и артефакты — не версионируем
node_modules/
logs/

# модели: вход и результат — большие бинарники, версионируем только код
input/
output/

# Модель, положенная В КОРЕНЬ, — тоже модель. Дыра найдена 2026-08-20: файл клиента на
# 192 МБ лежал рядом с package.json и был ВИДЕН для git, потому что правила закрывали
# только input/ и output/. Одного `git add -A` хватило бы, чтобы нарушить красную линию
# («клиентские и чужие модели в публичный репозиторий не попадают») — необратимо, потому
# что стирать такое из истории нельзя без переписывания истории.
#
# Золотого корпуса это не касается: у fixtures/ СВОЙ файл правил, и он подробнее — запрет
# по умолчанию плюс поимённый список того, что сделано автором проекта и потому едет в
# git. Вложенный файл главнее этого, и переписывать его отсюда нельзя: получилось бы
# «весь корпус версионируем», то есть ровно наоборот. Уже лежащие в git модели правило
# не трогает — на отслеживаемые файлы .gitignore не действует.
*.glb
*.gltf

# рабочая папка для временных файлов/бэкапов (не код)
_work/

# веб-интерфейс: загрузки и результаты обработки (большие бинарники, не код)
_web/

# Freebuff Desktop — база данных сессии (авто-генерируемая)
.freebuff/

# диагностика
diag_report.txt
vitest-report.json

# вложения vitest — PNG-скриншоты, которые браузерный прогон кладёт рядом с корнем.
# Каталог создаётся самим vitest, в репозитории ему делать нечего.
.vitest-attachments/

# скриншоты браузерных тестов — авто-генерируемые PNG при падении; .gitkeep остаётся
# в git, PNG-файлы игнорируются. В CI артефакт собирается напрямую с диска,
# .gitignore на него не влияет.
tests/__screenshots__/

# оптимизированные артефакты браузерных тестов — генерирует globalSetup
# (tests/instance-grid-build.setup.mjs), раздаёт Vite-мидлварь /optimized/.
# Бинарники в git не нужны: пересобираются при каждом прогоне.
tests/__optimized__/

# ---------------------------------------------------------------------------
# Внутренняя кухня разработки. Решение Александра, 2026-07-29: репозиторий
# публикуется как продукт, а не как дневник работы над ним.
#
# Файлы остаются на диске и продолжают использоваться — из git убраны только
# из индекса. Что именно скрыто:
#   .claude/     — рабочий журнал сессий (CONTEXT.md), настройки, скиллы, агенты
#   assistants/  — промпты вспомогательных моделей и 34 отчёта аудита
#   CLAUDE.md    — правила ведения проекта
#
# ВАЖНО: git-история их помнит. Если репозиторий публикуется вместе с историей,
# любой сможет прочитать их в старых коммитах. Чтобы этого не было, первый
# публичный релиз надо выкладывать отдельным репозиторием с чистой историей.
# ---------------------------------------------------------------------------
.claude/
assistants/
CLAUDE.md

# Планы, стратегия и внутренние обоснования. В публичном репозитории остаются
# только инженерные документы: как устроено и как расширять. Позиционирование
# и краткий взгляд в будущее — в README, одним абзацем, без дорожных карт.
docs/MISSION.md
docs/ROADMAP.md
docs/ROADMAP_дальше.md
docs/PLATFORM_SHOPIFY.md

# личные заметки-шпаргалки в корне
Текстовый документ.txt

# инструкция для Codex — внутренняя, как и CLAUDE.md
AGENTS.md

# ---------------------------------------------------------------------------
# Внутренняя кухня, часть вторая. Решение Александра 2026-08-05 при подготовке
# к публикации: «внутреннюю кухню нужно спрятать, это ни к чему».
#
# Всё это — отчёты о ходе работы и рабочие заметки, а не документация продукта.
# Файлы остаются на диске и продолжают использоваться, из git убраны из индекса.
# ---------------------------------------------------------------------------
docs/RELEASE-STATUS.md
fixtures/models/_КАНДИДАТ_*.md
fixtures/models/КЛИЕНТСКИЕ_МОДЕЛИ.md
tests/ОТЧЁТ_*.md
tests/architecture/ОТЧЁТ_*.md
assistants/ЗАДАНИЕ_*.md

# макет интерфейса от дизайн-инструмента: на него ничто не ссылается, в
# работающую программу он не входит
ui/concepts/

# Локальная установка KTX-Software, которую кладёт `npm run setup` под Linux
.tools/

# Собранные пакеты настольного приложения — артефакты сборки, не исходник.
dist-app/

# Ревью и разборы от коллег — внутренние материалы со ссылками на личное хранилище
Ревью кода*.md

# Собранное из TypeScript. В репозитории живёт источник (.mts), а не его след:
