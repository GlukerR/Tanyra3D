// tsconfig.json — настройка TypeScript для постепенного перехода.
//
// Решение Александра (2026-08-10): новые модули на TypeScript, рабочий JS не переписывать
// без нужды, миграцию вести без изменения поведения. Обёрток над JS не делать — код
// переносится в TypeScript и компилируется обратно в JS.
//
// Почему `.mts` → `.mjs`, а не отдельная папка сборки. Приложение исполняет исходники
// напрямую: `server.mjs` лежит в build.files как есть, Electron запускает его же, а импорты
// по всему дереву написаны с расширением (`./types.mjs`). Компилятор кладёт результат рядом
// с исходником под тем же именем, поэтому НИ ОДИН потребитель не меняется: был файл
// core/contract.mjs — остался core/contract.mjs, только теперь он собран из core/contract.mts.
// Отдельный outDir потребовал бы переписать пути импорта во всём дереве и в упаковке —
// это и есть то самое «изменение поведения», которого просили избегать.
//
// Собранные .mjs в git НЕ идут (см. .gitignore): в репозитории живёт источник, а не его
// след. Сборку выполняет `npm run build`; она же висит на `prepare`, поэтому после
// `npm ci` дерево готово к запуску — и на машине разработчика, и на раннере, и в упаковке.
{
  "compilerOptions": {
    // Node 22 — то, на чём идут тесты и релизная сборка (см. .github/workflows).
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Строго с самого начала. Ослабить потом можно, ужесточить на выросшем коде — нет.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Ошибка типов не должна оставлять на диске наполовину собранный модуль: приложение
    // запустилось бы со старым или битым файлом, и причина отказа была бы не та.
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,

    // Импорт типов обязан выглядеть как импорт типов: иначе после стирания типов остаётся
    // импорт несуществующего значения — отказ во время работы, которого компилятор не видел.
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Список объявлен явно, хотя по умолчанию берутся ВСЕ пакеты из node_modules/@types.
    // Причина не в аккуратности: 2026-08-11 первый же `import path from 'node:path'`
    // в core/registry.mts не собрался («Cannot find name 'node:path'») при том, что
    // @types/node лежал на месте — автоподхват в этой связке не сработал. С явным
    // списком собирается. Заодно исчезает случайная зависимость от того, что чужой
    // пакет притащил в @types свои глобальные имена.
    "types": ["node"]
  },
  // Только то, что уже переведено. Список растёт по мере миграции — по одному модулю,
  // а не «включим всё и посмотрим, сколько красного».
  "include": ["core/**/*.mts", "addons/**/*.mts"]
}
