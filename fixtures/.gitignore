# Бинарники моделей НЕ коммитим по умолчанию: репозиторий публичный (Apache-2.0),
# а у сторонних моделей своя лицензия — их коммит был бы нарушением.
# Версионируем только sidecar-лицензии (*.license.md), README, скрипт и снапшоты.
#
# Redistributable-модель (CC0 / явно разрешена) добавить явно, после фиксации лицензии:
#   git add -f fixtures/models/<имя>.glb
*.glb
*.gltf
*.bin
*.png
*.jpg
*.jpeg
*.webp
*.ktx2
*.basis

# ---------------------------------------------------------------------------
# Исключения: модели, сделанные автором проекта с нуля и распространяемые
# свободно. Они версионируются, чтобы базовый набор тестов проходил сразу после
# `git clone`, без просьбы «достаньте где-нибудь 3D-модели». Суммарно ~1.1 МБ.
# Решение Александра, 2026-07-28.
#
# Добавлять сюда ТОЛЬКО модель, у которой в sidecar `.license.md` стоит
# «Можно ли распространять: да». Сторонние (Sketchfab, Khronos) — никогда.
# ---------------------------------------------------------------------------
!models/Dirty Cube 01.glb
!models/Instance Grid 01.glb
!models/Morph Cube 01.glb
!models/Vertex Colors 01.glb
!models/Draco Compressed Input 01.glb
!models/Meshopt Compressed Input 01.glb
!models/Linked Duplicates Grid 01.glb
!models/Orphan Texture Cube 01.glb
!models/Preinstanced Grid 01.glb
!models/Truncated Broken 01.glb
!models/Unlinked Duplicates 01.glb

# Закрытие дыр реестра ситуаций, 2026-08-04 (_work/make-corpus-holes.mjs).
!models/Empty Nodes 01.glb
!models/Texture Only 01.glb
!models/Two Scenes 01.glb
!models/Pre KTX2 01.glb

# Расширения, которых библиотека не знает (_work/make-unknown-ext-fixtures.mjs,
# 2026-08-14). Образцы Khronos с такими расширениями в репозиторий не идут — чужая
# лицензия, — и на чистом клоне защита от их порчи не проверялась вовсе. Эти три
# сделаны нами, весят по полкилобайта и едут в git.
!models/Unknown Ext LOD 01.glb
!models/Unknown Ext Interactivity 01.glb
!models/Unknown Ext Pointer 01.glb

# Анимация по указателю, которая ДЕЙСТВИТЕЛЬНО проигрывается
# (_work/make-animation-pointer-fixture.mjs, 2026-08-15). Три модели выше только
# объявляют расширение — на них нельзя проверить показ. Полтора килобайта, Apache-2.0.
!models/Animated Pointer 01.glb

# Две дыры, найденные ФАЛЬСИФИКАЦИЕЙ 2026-08-15 (_work/make-viewer-gap-fixtures.mjs).
# Обе одного рода: код был верный, тесты его проверяли, но ни одна модель корпуса не
# отличала верный код от подменённого — подмену условия набор проглатывал зелёным.
#   Ortho Camera 01 — ортографическая камера (в корпусе таких не было вовсе);
#   Still Morphs 01 — формы есть, а клип двигает узел, а не веса.
# 888 и 1224 байта, Apache-2.0, валидатор Khronos чист.
!models/Ortho Camera 01.glb
!models/Still Morphs 01.glb
