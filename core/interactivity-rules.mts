// core/interactivity-rules.mts — что считается нажимаемой частью. Одно место на программу.
//
// ЗАЧЕМ ОТДЕЛЬНЫЙ МОДУЛЬ. Тот же случай, что у `core/lod-grouping.mts`, и вскрылся он
// ровно так же — расхождением на глазах у Александра. Отчёт сказал «нажимаемых частей
// 21», а окно обвело ОДНУ. Правы были оба по-своему: `MagicBall.glb` помечает 21 узел, но
// у двадцати из них стоит `"selectable": false` — автор прямо запретил на них нажимать.
// Окно это учитывало, движок нет.
//
// Один вопрос — один ответ в одном месте (Правила интерфейса §1). Данные у спрашивающих
// разные (движок читает JSON ассета, вьюпорт — загруженную сцену), а правило обязано быть
// общим, иначе оно снова разъедется.
//
// Модуль БЕЗ ЕДИНОГО ИМПОРТА — это условие, по которому слой ui вправе его читать
// (`tests/architecture/layer-boundaries.test.mjs`, список UI_SHARED_RULES).

/**
 * Помечен ли узел нажимаемым.
 *
 * `KHR_node_selectability` живёт на самом узле и несёт одно поле. Умолчание расширения —
 * «да»: поле есть, значит узел объявлен нажимаемым, пока автор не написал обратное. А
 * написанное `false` — такое же решение автора, как и `true`, и спорить с ним нельзя
 * (Правило 11): двадцать запрещённых узлов `MagicBall` — это замысел, а не недосмотр.
 *
 * @param extensions содержимое поля `extensions` у узла — из файла или из сцены
 */
export function isClickable(extensions: unknown): boolean {
  if (!extensions || typeof extensions !== 'object') return false;
  const mark = (extensions as Record<string, unknown>)['KHR_node_selectability'];
  if (!mark || typeof mark !== 'object') return false;
  return (mark as { selectable?: unknown }).selectable !== false;
}
