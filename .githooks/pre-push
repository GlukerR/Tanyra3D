#!/bin/sh
# pre-push — последний рубеж перед публикацией.
#
# Зачем именно здесь. `.gitignore` — это список запретов, а список запретов
# защищает ровно до первой ошибки: достаточно одного `git add -f`, одной
# опечатки в шаблоне, одной ветки, созданной до того, как правило появилось, —
# и внутренний файл уезжает наружу. Коммит откатить можно, отправку — уже нет:
# то, что попало на сервер, кто-то мог склонировать через минуту.
#
# Поэтому проверка стоит на push и смотрит не рабочее дерево, а СОДЕРЖИМОЕ
# ОТПРАВЛЯЕМЫХ КОММИТОВ вместе с их историей. Дерево может быть чистым, а
# история — нет: так и было 2026-08-06, когда в дереве не нашлось ни одного
# внутреннего пути, а в истории их лежало семьдесят.
#
# Обойти: PUBLISH_OK=1 git push … — осознанно и по прямой просьбе Александра.

set -e

BLACKLIST='^(\.claude/|assistants/|_work/|input/|output/|logs/|CLAUDE\.md$|AGENTS\.md$|docs/(MISSION|ROADMAP|ROADMAP_дальше|PLATFORM_SHOPIFY|RELEASE-STATUS)\.md$|ui/concepts/)|КЛИЕНТСКИЕ|ОТЧЁТ_|КАНДИДАТ'

if [ "$PUBLISH_OK" = "1" ]; then
  echo "pre-push: проверка отключена (PUBLISH_OK=1)"
  exit 0
fi

fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # удаление ветки — проверять нечего
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # новая ветка на сервере: смотрим ВСЮ её историю, а не «что нового»
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # Все пути, которые когда-либо трогали отправляемые коммиты.
  #
  # core.quotepath=false обязателен. По умолчанию git отдаёт неascii-пути
  # экранированными («docs/\320\232\320\233...»), и шаблон с русскими буквами
  # не совпадает НИКОГДА. Первая же проверка хука это и показала: файл
  # «docs/КЛИЕНТСКИЕ-проверка.md» уехал в «сервер», а хук отрапортовал «чисто».
  paths=$(git -c core.quotepath=false log --pretty=format: --name-only "$range" 2>/dev/null | sort -u | grep -v '^$' || true)

  hits=$(printf '%s\n' "$paths" | grep -E "$BLACKLIST" || true)

  if [ -n "$hits" ]; then
    echo ""
    echo "❌ ОТПРАВКА ОСТАНОВЛЕНА: в отправляемых коммитах есть внутренние файлы."
    echo ""
    printf '%s\n' "$hits" | sed 's/^/    /'
    echo ""
    echo "  Это внутренняя кухня: журнал сессий, задания ассистентам, правила"
    echo "  ведения проекта, планы, клиентские материалы. Репозиторий"
    echo "  публикуется как продукт, а не как дневник работы над ним."
    echo ""
    echo "  Файл в рабочем дереве? Хорошо — он там и останется. Убрать надо из"
    echo "  ИСТОРИИ отправляемых коммитов, а это переписывание: делается на"
    echo "  копии и только по прямой просьбе Александра."
    echo ""
    fail=1
  fi
done

if [ "$fail" = "1" ]; then
  echo "  Осознанно отправить всё равно:  PUBLISH_OK=1 git push ..."
  echo ""
  exit 1
fi

echo "pre-push: внутренних файлов в отправляемых коммитах нет"
exit 0
