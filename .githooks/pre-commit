#!/bin/sh
# Pre-commit hook: запускает тесты перед коммитом.
# Установка: git config core.hooksPath .githooks

# Два файла, а не один. Почему:
#
#   tests/optimize.test.mjs целиком обёрнут в describeIfModels(['CarConcept.glb']),
#   а CarConcept — модель Khronos, в репозиторий она не коммитится. На машине
#   Александра файл есть и хук работает; после свежего `git clone` файла нет,
#   весь набор пропускается, vitest возвращает 0 — и хук пропускает коммит,
#   не проверив ни строчки. Страховка, которая молча выключается у нового
#   участника, хуже отсутствующей: про отсутствующую хотя бы знают.
#
#   tests/gap-005-regression.test.mjs работает на Morph Cube 01 — одной из
#   десяти моделей, которые лежат в git (см. исключения в fixtures/.gitignore).
#   Она есть всегда, поэтому этот файл выполняется и после чистого клона.
#   Идёт меньше секунды и держит baseline-checkpoint — то, что ломается тише
#   всего остального.
#
# Полный набор (npx vitest run) в хук не ставим сознательно: он идёт четыре-пять
# минут, и хук такой длины начнут обходить через --no-verify. Полный прогон — перед
# релизом, а не перед каждым коммитом.

# Сборка TypeScript ПЕРЕД тестами. Иначе правка в core/*.mts не доедет до прогона:
# тесты импортируют собранные .mjs, и без этого шага они проверяли бы предыдущую
# версию модуля — зелёный результат, ничего не говорящий о том, что коммитится.
# Идёт около секунды. noEmitOnError в tsconfig означает, что битый тип сюда не пройдёт.
echo "🔧 Building TypeScript..."
npm run build --silent
if [ $? -ne 0 ]; then
  echo "❌ TypeScript build failed. Commit aborted."
  exit 1
fi

# Линтер ПОСЛЕ сборки и ДО тестов. Добавлен 2026-08-19 после красного CI на всех трёх
# версиях Node: в тесте стоял живой символ BOM внутри регулярного выражения, eslint
# запрещает такие «неправильные пробелы» — а хук проверял только сборку и два файла
# тестов, поэтому дефект спокойно доехал до origin.
#
# Почему это не «ещё одна долгая проверка»: eslint по всему дереву идёт около двух
# секунд — на порядок меньше сборки, которая уже здесь. Ловит он ровно тот класс, что
# CI ловит первым шагом, и обиднее всего пропускать именно его: полсотни зелёных тестов
# и красный конвейер из-за невидимого символа.
echo "🧹 Linting..."
npm run lint --silent
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Commit aborted."
  exit 1
fi

echo "🔍 Running tests before commit..."

npx vitest run tests/optimize.test.mjs tests/gap-005-regression.test.mjs
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "❌ Tests failed. Commit aborted. Fix the tests and try again."
  exit 1
fi

echo "✅ All tests passed. Proceeding with commit."
exit 0
