/**
 * JSON-часть ИСХОДНОГО файла — один читатель на всех, кто её спрашивает.
 *
 * ЗАЧЕМ ОТДЕЛЬНЫЙ МОДУЛЬ. Спрашивающих трое, и до 2026-08-22 каждый читал файл сам:
 *
 *   • `referencedResources` (index) — на кого ссылается `.gltf`: нужно, чтобы честно
 *     посчитать вес пачки и назвать недостающих соседей;
 *   • `writeBytes` (index) — что перенести в собранный файл из исходного;
 *   • `assetJson` (rules) — незнакомые расширения и уровни детализации.
 *
 * Замер на самодостаточном `.gltf` 24,3 МБ (наше же окно выгрузки такие и отдаёт):
 * **три полных чтения файла, два из них строкой, и четыре полных разбора JSON** за один
 * прогон. На `.glb` 18,2 МБ — одно лишнее чтение целого файла там, где хватает заголовка
 * и одного чанка.
 *
 * Причина была не в жадности, а в том, что читатели не знали друг о друге: один из трёх
 * (`sourceJson`) уже умел читать у GLB только чанк, и в его комментарии прямо сказано
 * почему — «модели у нас доходят до 600 МБ». Второй (`readAssetJson` в rules) делал ту же
 * работу, но вычитывал файл целиком. Одинаковое знание в двух видах — это не дублирование
 * кода, это разъезжающееся поведение.
 *
 * ЧТО ЗДЕСЬ НЕ КЭШИРУЕТСЯ И ПОЧЕМУ. Разобранный JSON самодостаточного `.gltf` — это
 * встроенные картинки и буферы в base64, то есть сотни мегабайт. Запомнить его между
 * вызовами значило бы держать их всё время работы программы: лечение хуже болезни. Кто
 * зовёт часто — кэширует У СЕБЯ то МАЛОЕ, что ему нужно (список ссылок, набор расширений),
 * и разобранный документ отпускается сразу.
 */

import fs from 'node:fs';

// Волшебные числа контейнера GLB (спецификация glTF 2.0, §4.4).
const GLB_MAGIC = 0x46546c67;   // 'glTF'
const CHUNK_JSON = 0x4e4f534a;  // 'JSON'
const GLB_HEADER = 12;          // заголовок контейнера: магия, версия, общая длина
const CHUNK_HEADER = 8;         // шапка чанка: длина и тип

/** Форма нам безразлична: каждый спрашивающий берёт своё поле и сам знает, что это. */
export type SourceJson = Record<string, unknown>;

/**
 * Прочитать JSON-часть файла: у `.glb` — первый чанк, у `.gltf` — сам файл.
 *
 * У GLB читаются ЗАГОЛОВОК И ОДИН ЧАНК, а не файл целиком: сто мегабайт ради килобайта
 * оглавления — не чтение, а трата. У `.gltf` иначе нельзя, он весь и есть этот JSON.
 *
 * Нечитаемое — не беда: возвращаем null. Разбираться с испорченным файлом будет сама
 * загрузка, у неё для этого есть и место, и слова (см. readOrExplain в index).
 */
export function readSourceJson(src: string): SourceJson | null {
  let fd: number | null = null;
  try {
    fd = fs.openSync(src, 'r');
    const head = Buffer.alloc(GLB_HEADER);
    const got = fs.readSync(fd, head, 0, GLB_HEADER, 0);
    if (got === GLB_HEADER && head.readUInt32LE(0) === GLB_MAGIC) {
      const total = head.readUInt32LE(8);
      // Чанки ОБХОДИМ, а не берём первый на веру. По спецификации JSON обязан быть
      // первым, и в жизни он первый всегда — но один из двух прежних читателей обход
      // делал, и сводить их в один, потеряв его терпимость, было бы починкой со
      // ступенькой вниз. Читаются при этом только ШАПКИ чанков по восемь байт: обход
      // ничего не стоит, а тело берётся ровно одно — то, за которым пришли.
      let off = GLB_HEADER;
      const chunkHead = Buffer.alloc(CHUNK_HEADER);
      while (off + CHUNK_HEADER <= total) {
        if (fs.readSync(fd, chunkHead, 0, CHUNK_HEADER, off) !== CHUNK_HEADER) break;
        const len = chunkHead.readUInt32LE(0);
        const type = chunkHead.readUInt32LE(4);
        if (type === CHUNK_JSON) {
          const chunk = Buffer.alloc(len);
          fs.readSync(fd, chunk, 0, len, off + CHUNK_HEADER);
          return JSON.parse(chunk.toString('utf8'));
        }
        off += CHUNK_HEADER + len;
      }
      // Контейнер GLB без JSON-чанка. Целиком его читать незачем: строкой это не JSON и
      // разбором не станет — только зря прогоним через память сто мегабайт.
      return null;
    }
    // .gltf — обычный JSON, читаем целиком: он и есть весь документ.
    fs.closeSync(fd); fd = null;
    return JSON.parse(fs.readFileSync(src, 'utf8'));
  } catch {
    return null;
  } finally {
    if (fd !== null) { try { fs.closeSync(fd); } catch { /* уже закрыт */ } }
  }
}

/**
 * Отпечаток файла: путь, время правки и размер.
 *
 * Нужен тем, кто запоминает у себя МАЛЫЙ вывод разбора: по отпечатку видно, что файл с
 * тех пор не подменили. Времени правки одного мало — на быстрых операциях оно совпадает;
 * размер закрывает самый частый случай подмены, а большего этой памяти и не требуется:
 * она живёт внутри одного прогона над одним файлом.
 */
export function sourceStamp(src: string): string {
  try {
    const st = fs.statSync(src);
    return `${src}|${st.mtimeMs}|${st.size}`;
  } catch {
    return `${src}|нет`;
  }
}
