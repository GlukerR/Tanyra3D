/**
 * Качество ИСХОДНОЙ текстуры — потолок, выше которого прыгнуть нельзя.
 *
 * Введено 2026-08-17 по мысли Александра: «если они уже сжаты, мы ведь не можем вернуть
 * качество. это нереально верно? значит это для нас уже и есть всегда 100 процентное
 * качество». Мысль верна физически, и из неё следует вся шкала ползунка: 100 — «как в
 * исходнике», ниже — доля от него. Выше 100 не бывает: уничтоженное первым кодеком не
 * возвращается, и деление там было бы обманом.
 *
 * Прежде правило кодировало ВСЁ в жёсткий q90 — одно число на любой источник. Это и
 * давало обе беды сразу: на исходнике q77 мы «улучшали» его до q90 и платили весом за
 * бережное копирование чужих артефактов, а на исходнике q97 — незаметно огрубляли.
 * Замер на ABeautifulGame (33 текстуры): жёсткий q90 даёт −41 %, прицел в потолок −60 %.
 *
 * Потолок читается по-разному, и разница между способами принципиальна:
 *
 *   JPEG          — ТОЧНО. В файле лежит таблица квантования (маркер DQT), полученная
 *                   делением стандартной таблицы IJG на масштаб качества; ход обратим.
 *                   Стоит микросекунды и не кодирует ни одного пикселя.
 *   PNG и прочее
 *   без потерь    — потолка нет: исходник идеален. «100 %» для него — WebP без потерь.
 *                   Это не раздувает файл (замер: BoomBox 10161 → 5655 КБ, CarConcept
 *                   2855 → 2190 КБ) — WebP без потерь просто лучше PNG.
 *   WebP          — качества в файле НЕТ ВОВСЕ, формат его не хранит. Только ОЦЕНКА
 *                   пробными кодированиями: ищем q, на котором наш размер сравняется с
 *                   авторским. Пять кодирований на текстуру, поэтому вызывается лишь
 *                   когда без него не обойтись (ползунок сдвинут с «как в исходнике»).
 *   KTX2          — сравнивать не с чем: его байты живут в другой системе координат,
 *                   и «размер сравнялся» там ничего не значит. Потолок неизвестен,
 *                   и правило обязано сказать об этом вслух, а не подставить число молча.
 */

/**
 * Стандартная таблица квантования яркости IJG (Annex K спецификации JPEG). Эталон,
 * относительно которого библиотеки масштабируют свои таблицы: quant = (std·scale + 50)/100.
 */
const STD_LUMA = [
  16, 11, 10, 16, 24, 40, 51, 61, 12, 12, 14, 19, 26, 58, 60, 55,
  14, 13, 16, 24, 40, 57, 69, 56, 14, 17, 22, 29, 51, 87, 80, 62,
  18, 22, 37, 56, 68, 109, 103, 77, 24, 35, 55, 64, 81, 104, 113, 92,
  49, 64, 78, 87, 103, 121, 120, 101, 72, 92, 95, 98, 112, 100, 103, 99,
];

/** Как узнан потолок — от этого зависит, что правило напишет в отчёт. */
export type CeilingSource = 'lossless' | 'jpeg' | 'probe' | 'unknown';

export interface Ceiling {
  /** Качество исходника 1…100, либо null — источник без потерь (потолка нет). */
  q: number | null;
  how: CeilingSource;
}

/**
 * Качество JPEG из маркера DQT. null — не JPEG либо таблицы нет.
 *
 * Обход маркеров, а не поиск байт `FF DB` где попало: последовательность может
 * встретиться внутри сжатых данных, и тогда за таблицу квантования будет принят мусор.
 */
export function jpegQuality(bytes: Uint8Array): number | null {
  if (bytes.length < 4 || bytes[0] !== 0xff || bytes[1] !== 0xd8) return null;
  let i = 2;
  while (i < bytes.length - 4) {
    if (bytes[i] !== 0xff) { i += 1; continue; }
    const marker = bytes[i + 1]!;
    // Маркеры без полезной нагрузки (RSTn, SOI, EOI) длины не несут — у них её нельзя читать.
    if (marker === 0xd8 || (marker >= 0xd0 && marker <= 0xd9)) { i += 2; continue; }
    const len = (bytes[i + 2]! << 8) | bytes[i + 3]!;
    if (len < 2) return null; // испорченный заголовок: дальше идти небезопасно
    if (marker === 0xdb) {
      // +5: два байта длины и байт точности/идентификатора таблицы.
      const table = bytes.subarray(i + 5, i + 5 + 64);
      if (table.length < 64) return null;
      let sum = 0;
      for (let k = 0; k < 64; k++) sum += (table[k]! * 100 - 50) / STD_LUMA[k]!;
      const scale = sum / 64;
      const q = scale <= 100 ? 100 - scale / 2 : 5000 / scale;
      return Math.min(100, Math.max(1, Math.round(q)));
    }
    i += 2 + len;
  }
  return null;
}

/** Байты обещают формат без потерь? mime не спрашиваем: он врёт (замер 2026-08-17). */
export function isLosslessSource(bytes: Uint8Array): boolean {
  // PNG: 89 50 4E 47
  if (bytes.length > 8 && bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4e && bytes[3] === 0x47) return true;
  // WebP без потерь: RIFF....WEBPVP8L. Лоссовый несёт VP8␣ либо VP8X.
  if (bytes.length > 16
    && bytes[0] === 0x52 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x46
    && bytes[8] === 0x57 && bytes[9] === 0x45 && bytes[10] === 0x42 && bytes[11] === 0x50) {
    return bytes[12] === 0x56 && bytes[13] === 0x50 && bytes[14] === 0x38 && bytes[15] === 0x4c;
  }
  return false;
}

/**
 * Потолок исходника без единого кодирования.
 *
 * Оценку WebP сюда НЕ включаем намеренно: она стоит пяти кодирований, а вызывать её
 * нужно далеко не всегда. Кто её хочет — зовёт `probeWebpCeiling` осознанно.
 */
export function readCeiling(bytes: Uint8Array, mime: string): Ceiling {
  if (isLosslessSource(bytes)) return { q: null, how: 'lossless' };
  const jpeg = jpegQuality(bytes);
  if (jpeg !== null) return { q: jpeg, how: 'jpeg' };
  // По БАЙТАМ, а не по mime. Модуль сам себе это запретил абзацем выше, и всё же ветка
  // зонда выбиралась по объявленному типу: лоссовый WebP с пустым mime уходил в
  // «неизвестно», получал подставные 90 и перекодировался даже при ползунке на сотне
  // (найдено ревью 2026-08-18). Контейнер RIFF/WEBP мы уже умеем узнавать.
  if (isWebpContainer(bytes) || mime === 'image/webp') return { q: null, how: 'probe' };
  return { q: null, how: 'unknown' }; // KTX2 и всё незнакомое
}

/** Контейнер RIFF/WEBP — без разбора того, лоссовый он или нет. */
function isWebpContainer(bytes: Uint8Array): boolean {
  return bytes.length > 12
    && bytes[0] === 0x52 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x46
    && bytes[8] === 0x57 && bytes[9] === 0x45 && bytes[10] === 0x42 && bytes[11] === 0x50;
}

/** Кодировщик: ровно то, что нужно зонду от sharp, без зависимости от самой библиотеки. */
export type EncodeAt = (quality: number) => Promise<{ byteLength: number }>;

/** Сколько кодирований тратим на оценку одного потолка. Замер: 11 текстур → 55 проб, 32 с. */
const PROBE_STEPS = 5;

/**
 * Оценка потолка лоссового WebP: на каком q наш кодировщик даёт размер автора.
 *
 * Двоичный поиск по 30…100 вместо перебора: качество и размер связаны монотонно, а точнее
 * целого числа здесь всё равно не нужно — оценка и так помечена словом «примерно». Ниже 30
 * не спускаемся: такой исходник уже за гранью, и уточнять там нечего.
 *
 * На краях ответ упирается, а не измеряет, и упирается он НЕ в границы диапазона: за пять
 * шагов от 30…100 поиск доходит только до 32 снизу и до 99 сверху (проверено ревью
 * 2026-08-18). То есть 32 в ответе читается как «тридцать два или меньше», 99 — как
 * «девяносто девять или больше»; на точность доли от потолка это не влияет.
 */
export async function probeWebpCeiling(sourceBytes: number, encodeAt: EncodeAt): Promise<number> {
  let lo = 30;
  let hi = 100;
  let best = 100;
  // Ровно PROBE_STEPS шагов, а не «пока диапазон не схлопнется». Полный поиск по 30…100
  // взял бы семь кодирований вместо пяти ради последнего целого числа, которое всё равно
  // теряется под словом «примерно». Пять — это и есть та цена, на которой всё мерилось.
  for (let step = 0; step < PROBE_STEPS && lo <= hi; step++) {
    const mid = Math.round((lo + hi) / 2);
    const out = await encodeAt(mid);
    best = mid;
    if (out.byteLength > sourceBytes) hi = mid - 1; else lo = mid + 1;
  }
  return Math.min(100, Math.max(1, best));
}

/**
 * Целевое качество: доля `share` (0…100) от потолка.
 *
 * Источник без потолка (PNG) считается за 100 — тогда доля становится качеством напрямую,
 * и шкала остаётся одной для всех источников.
 */
export function targetQuality(ceiling: Ceiling, share: number): number {
  const base = ceiling.q ?? 100;
  return Math.min(100, Math.max(1, Math.round(base * share / 100)));
}
