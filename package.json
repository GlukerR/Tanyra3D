{
  "name": "tanyra3d",
  "version": "0.0.9",
  "private": true,
  "license": "Apache-2.0",
  "description": "Умный оптимизатор GLB/glTF для веба — анализ, безопасная оптимизация, отчёты",
  "_comment_author": "Почта обязательна для пакета .deb — там это поле сопровождающего, без него сборка отказывается. Взят скрытый адрес GitHub, а не личный: он уходит в каждый скачанный пакет и достаётся сборщикам спама, а письма через GitHub доходят так же (решение Александра, 2026-08-08).",
  "author": "GlukerR <GlukerR@users.noreply.github.com>",
  "homepage": "https://github.com/GlukerR/Tanyra3D",
  "repository": { "type": "git", "url": "https://github.com/GlukerR/Tanyra3D.git" },
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "app": "electron .",
    "app:tools": "node scripts/bundle-ktx.mjs",
    "app:build": "node scripts/bundle-ktx.mjs --optional && electron-builder"
  },
  "dependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "draco3dgltf": "^1.5.7",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "_comment_overrides": "ndarray-pixels (внутри @gltf-transform/functions) требует sharp ^0.34, а уязвимость GHSA-f88m-g3jw-g9cj закрыта только в 0.35. Своей зависимостью её не достать — она вложенная, поэтому override. Снять, когда gltf-transform обновит ndarray-pixels.",
  "overrides": {
    "sharp": "^0.35.3"
  },
  "_comment_build": "asar намеренно выключен. Внутри архива живут нативный sharp, форк server.mjs и раздача three.js прямо из node_modules — каждое из трёх работает в asar с оговорками, и проверить их можно только на своей платформе. Сборки под macOS и Linux собирает CI, вслепую; цена asar — несколько секунд установки, цена ошибки в нём — неработающая сборка, о которой мы узнаем от пользователя.",
  "build": {
    "appId": "com.tanyra3d.app",
    "productName": "Tanyra3D",
    "asar": false,
    "directories": { "output": "dist-app", "buildResources": "desktop/build" },
    "files": [
      "server.mjs", "optimize2.mjs", "assistant.mjs", "package.json",
      "core/**/*", "addons/**/*", "ui/**/*", "translations/**/*",
      "profiles/**/*", "messages/**/*", "desktop/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**", "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**", "!node_modules/playwright*/**",
      "!node_modules/vitest/**", "!node_modules/@vitest/**",
      "!**/*.map", "!**/test/**", "!**/tests/**", "!**/docs/**"
    ],
    "extraResources": [
      { "from": ".tools", "to": "tools", "filter": ["**/*"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "Tanyra3D-${version}-windows-${arch}.${ext}" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "Tanyra3D-${version}-linux-${arch}.${ext}",
      "desktopName": "tanyra3d.desktop",
      "synopsis": "3D model optimizer for the web",
      "syncDesktopName": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "artifactName": "Tanyra3D-${version}-macos-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "es-module-lexer": "^2.3.1",
    "playwright": "^1.62.0",
    "vitest": "^4.1.10"
  }
}
